<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto Clicker Android 15"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Desconocido"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btn_enable_service"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:text="Activar Servicio de Accesibilidad"
        android:backgroundTint="#2196F3"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Esta app detectará botones como 'Aceptar' o 'Siguiente' y hará click automáticamente."
        android:textAlignment="center"
        android:alpha="0.7" />

</LinearLayout>
